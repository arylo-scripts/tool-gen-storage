{
  "name": "@arylo-scripts/tool-gen-storage",
  "version": "1.0.0",
  "description": "Tiny typed storage adapters with optional in-memory caching.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "concurrently -m 1 --timings npm:lint:*",
    "lint:type-check": "tsc -p tsconfig.json --noEmit",
    "lint:formatter": "oxfmt --check",
    "lint:oxlint": "oxlint",
    "fix:formatter": "oxfmt",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "24.12.0"
  },
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arylo-scripts/tool-gen-storage.git"
  },
  "homepage": "https://github.com/arylo-scripts/tool-gen-storage#readme",
  "bugs": {
    "url": "https://github.com/arylo-scripts/tool-gen-storage/issues"
  },
  "devDependencies": {
    "@arylo-scripts/tsconfig": "github:arylo-scripts/tsconfig#master",
    "concurrently": "^8.2.2",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.58.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
